# ===========================================
# NEXUS AI Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values.
# .env is git-ignored and should NEVER be committed.

# Application
APP_ENV=development
LOG_LEVEL=DEBUG

# Database (PostgreSQL 16 + pgvector)
DATABASE_URL=postgresql+asyncpg://nexus:nexus_dev@localhost:5432/nexus

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM API Keys (JSON object string)
# Supported providers: deepseek, openai, anthropic
LLM_API_KEYS={"deepseek":"sk-your-deepseek-key","openai":"sk-your-openai-key","anthropic":"sk-your-anthropic-key"}
DEFAULT_LLM_MODEL=deepseek-chat

# Encryption key for API Key storage at rest (AES-256)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=change-me-to-a-random-64-char-hex-string

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost,http://localhost:80

# WebSocket
WS_HEARTBEAT_INTERVAL=30
WS_MAX_RECONNECT_DELAY=30

# Sandbox (Docker container limits)
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_LIMIT=1.0
SANDBOX_TIMEOUT=60

# Security
AUDIT_LOG_RETENTION_DAYS=90
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_MINUTE_LLM=10
